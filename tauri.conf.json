{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omusic",
  "version": "0.1.0",
  "identifier": "org.omusic.tray",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "omusic",
        "width": 760,
        "height": 530,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
